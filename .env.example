# Set secrets in the hosting environment; never commit real values here.
ADMIN_USERNAME=admin
STORE_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional AI provider settings. The assistant uses catalog-based help without a key.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Optional server settings.
HOST=127.0.0.1
PORT=8000
# Set this to a persistent writable directory on your host for database and uploads.
APP_DATA_DIR=./data
# Set HTTPS=true when TLS terminates directly in front of this app.
HTTPS=false

# Vercel production persistence (create these values in Supabase and Vercel).
DATABASE_URL=postgresql://postgres.PROJECT_REF:password@POOLER_HOST:6543/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=product-images
